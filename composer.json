{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nexo/demo",
    "type": "project",
    "description": "Fictional association treasury demo.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check:migrations": "bash scripts/check-migrations.sh",
        "ci": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test",
            "@check:migrations",
            "@composer audit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
