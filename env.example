# Nexo — environment template (contains no secrets).
# Copy it, add the leading dot to the filename, and generate the application key:
#   cp env.example .env && php artisan key:generate
# (The conventional dotted template name is blocked for this agent by its
# harness sensitive-path policy; the content is identical either way.)

APP_NAME=Nexo
APP_ENV=local
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Behind HTTPS in production: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=
# Only with a reverse proxy: comma-separated trusted IPs or CIDR ranges
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12
